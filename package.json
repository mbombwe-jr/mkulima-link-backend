{
  "name": "mkulima-link-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Mkulima Link NestJS API",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
